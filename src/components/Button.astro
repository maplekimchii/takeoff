---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  download?: boolean;
}
const { href, variant = 'primary', download = false } = Astro.props;
---

<a class:list={['btn', variant]} href={href} download={download ? '' : undefined}><slot /></a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 16px 24px;
    border: 1px solid;
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .primary {
    background: var(--sky-blue);
    border-color: var(--sky-blue);
    color: var(--ink);
  }
  .primary:hover { background: #8ad5f0; }
  .secondary {
    background: var(--white);
    border-color: var(--main-blue);
    color: var(--main-blue);
  }
  .secondary:hover { background: var(--silver-100); }
</style>
