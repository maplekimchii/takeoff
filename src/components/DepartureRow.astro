---
import StatusBadge, { type Status } from './StatusBadge.astro';

interface Props {
  code: string;
  type: string;
  title: string;
  href: string;
  date: string;
  status: Status;
}
const { code, type, title, href, date, status } = Astro.props;
---

<li class="departure">
  <span class="code">{code}</span>
  <span class="type"><span class="chip">{type}</span></span>
  <a class="title" href={href}>{title}</a>
  <span class="date">{date}</span>
  <StatusBadge status={status} />
</li>

<style>
  .departure {
    display: flex;
    align-items: center;
    gap: 0;
    min-height: 44px;
    padding: 11px 18px;
    border-top: 1px solid var(--silver-200);
  }
  .departure:first-child { border-top: 0; }
  .code {
    flex: 0 0 120px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--main-blue);
  }
  .type { flex: 0 0 140px; }
  .chip {
    padding: 3px 8px;
    border-radius: 3px;
    background: var(--silver-100);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
  }
  .title {
    flex: 1;
    min-width: 0;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
    text-transform: uppercase;
  }
  .date {
    flex: 0 0 150px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  @media (max-width: 767px) {
    .departure { flex-wrap: wrap; gap: 6px 12px; }
    .type { display: none; }
    .code { flex-basis: auto; }
    .title { flex-basis: 100%; order: 3; }
    .date { flex-basis: auto; margin-left: auto; }
  }
</style>
