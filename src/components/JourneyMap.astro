---
import { Picture } from 'astro:assets';
import basemap from '../assets/inflight-basemap.png';
import { getCities } from '../lib/content';
import { H, VIS, W, cameraFor, formatKm, heading, legSamples, pathD, project, toScreen } from '../lib/journey';

interface Props {
  /** Interactive map with slider (About) or static final-step preview (Home). */
  interactive?: boolean;
}
const { interactive = false } = Astro.props;

const cities = (await getCities()).map((c) => ({ code: c.id, ...c.data }));
const legs = cities.slice(0, -1).map((_, i) => legSamples(cities, i));
const total = cities.at(-1)!.km;
const last = cities.length;

// Server-rendered state: step 1 for the interactive map, final step for the preview.
const step = interactive ? 1 : last;
const cam = cameraFor(step, cities, legs, VIS);
const pts = cities.map((c) => toScreen(project(c), cam));
const planeAngle =
  step === 1 ? heading(legs[0][0], legs[0][1]) : heading(legs[step - 2].at(-2)!, legs[step - 2].at(-1)!);
const pct = ([x, y]: [number, number]) => `left:${(x / W) * 100}%;top:${(y / H) * 100}%`;
const pinState = (i: number) => (i === step - 1 ? 'current' : i < step - 1 ? 'visited' : 'future');
const legOpacity = (i: number) => (i < step - 2 ? 0.55 : i === step - 2 ? 1 : 0);
const worldTransform = `translate(${(cam.tx / W) * 100}%, ${(cam.ty / H) * 100}%) scale(${cam.s})`;
const current = cities[step - 1];
const stopPct = (km: number) => (km / total) * 100;
---

<figure
  class:list={['journey', interactive ? 'interactive' : 'preview']}
  data-journey={interactive ? JSON.stringify(cities) : undefined}
  data-step={step}
>
  <div class="frame">
  <div class="stage">
    <div class="world" style={`transform:${worldTransform}`}>
      <Picture
        src={basemap}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[1280, 1920, 2560]}
        sizes={interactive ? '(max-width: 767px) 1280px, 2560px' : '(max-width: 1023px) 100vw, 680px'}
        alt=""
        loading="lazy"
        decoding="async"
        class="basemap"
      />
      <svg class="routes" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
        {legs.map((leg, i) => (
          <path d={pathD(leg)} data-leg={i} style={`opacity:${legOpacity(i)}`} />
        ))}
      </svg>
    </div>

    <div class="markers" aria-hidden="true">
      {cities.map((c, i) => (
        <>
          <span class:list={['pin', pinState(i)]} data-pin={i} style={pct(pts[i])}></span>
          <span class:list={['label', `at-${c.label}`, pinState(i)]} data-label={i} style={pct(pts[i])}>{c.city}</span>
        </>
      ))}
      <img
        class="plane"
        src="/img/aircraft-top.svg"
        alt=""
        width="62"
        height="58"
        style={`${pct(pts[step - 1])};--rot:${planeAngle}deg`}
      />
    </div>

    <p class="credit">Imagery: NASA Blue Marble · Borders: Natural Earth</p>
  </div>

    <div class="hud">
      <div class="hud-left">
        <span class="hud-label">Distance flown</span>
        <span class="hud-value" data-distance>{formatKm(current.km)}</span>
      </div>

      <div class="hud-centre">
        <div class="track-wrap">
          {interactive && <span class="hint" data-hint>Slide to take off →</span>}
          <div
            class="track"
            role={interactive ? 'slider' : undefined}
            tabindex={interactive ? 0 : undefined}
            aria-label={interactive ? 'Journey step' : undefined}
            aria-valuemin={interactive ? 1 : undefined}
            aria-valuemax={interactive ? last : undefined}
            aria-valuenow={interactive ? step : undefined}
            aria-valuetext={interactive ? `${current.city}, ${current.km.toLocaleString('en-CA')} km` : undefined}
          >
            <span class="rail"></span>
            <span class="progress" style={`width:${stopPct(current.km)}%`}></span>
            {cities.map((c, i) => (
              <span class:list={['stop', { reached: i <= step - 1, current: i === step - 1 }]} data-stop={i} style={`left:${stopPct(c.km)}%`}>
                <span class="stop-code">{c.code}</span>
              </span>
            ))}
            <span class="thumb" style={`left:${stopPct(current.km)}%`}>
              <span class="thumb-shadow"></span>
              <img class="thumb-plane" src="/img/aircraft-side.svg" alt="" width="67" height="23" />
            </span>
          </div>
        </div>
      </div>

      <div class="hud-right">
        <span class="hud-label" data-now-label>{step === last ? 'Current base' : 'Now at'}</span>
        <span class:list={['hud-value', { base: step === last }]} data-now>{current.city.toUpperCase()}</span>
      </div>
    </div>
  </div>

  <figcaption class="visually-hidden">
    Cities I’ve lived in, in order:
    <ol>
      {cities.map((c) => <li>{c.city}, {c.country}</li>)}
    </ol>
  </figcaption>
  <p class="visually-hidden" aria-live="polite" data-live></p>
</figure>

{interactive && (
  <script>
    import { initJourney } from '../lib/journey-client';
    document.querySelectorAll<HTMLElement>('.journey.interactive').forEach(initJourney);
  </script>
)}

<style>
  .journey {
    --ink-hud: var(--ink);
  }
  .frame {
    position: relative;
    container-type: inline-size;
    background: var(--ink);
  }
  .stage {
    position: relative;
    aspect-ratio: 1280 / 520;
    overflow: hidden;
  }
  .world {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    will-change: transform;
  }
  .world :global(.basemap),
  .world :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .world :global(img.basemap) { object-fit: cover; }
  .routes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .routes path {
    fill: none;
    stroke: var(--sky-blue);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .preview .routes path { stroke-width: 2.5; }

  .markers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .pin {
    position: absolute;
    width: max(6px, 0.703cqw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 0 0 1.5px var(--ink);
    transform: translate(-50%, -50%);
  }
  .pin.current {
    width: max(9px, 1.094cqw);
    background: var(--flap-yellow);
  }
  .pin.future, .label.future { visibility: hidden; }

  .label {
    position: absolute;
    font-weight: 700;
    font-size: max(10px, 0.9375cqw);
    line-height: 1.2;
    color: var(--white);
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.85);
    white-space: nowrap;
  }
  .label.at-right { transform: translate(max(8px, 0.8cqw), -50%); }
  .label.at-left { transform: translate(calc(-100% - max(8px, 0.8cqw)), -50%); }
  .label.at-right-below { transform: translate(max(8px, 0.8cqw), 2px); }
  .label.at-right-above { transform: translate(max(8px, 0.8cqw), calc(-100% - 2px)); }
  .label.current {
    font-size: max(11px, 1.016cqw);
    color: var(--flap-yellow);
    transform: translate(-50%, calc(-100% - max(22px, 2.6cqw)));
  }
  .preview .pin { width: max(4px, 0.703cqw); }
  .preview .pin.current { width: max(6px, 1.094cqw); }
  .preview .label { font-size: max(7px, 0.9375cqw); }
  .preview .label.current { font-size: max(8px, 1.016cqw); }

  .plane {
    position: absolute;
    width: max(30px, 4.84cqw);
    height: auto;
    transform-origin: 47.26% 48.3%;
    transform: translate(-47.26%, -48.3%) rotate(var(--rot, 0deg));
  }
  .preview .plane { width: max(18px, 4.84cqw); }

  .credit {
    position: absolute;
    right: 1.2cqw;
    bottom: calc(12.3% + 6px);
    font-family: var(--font-mono);
    font-size: max(8px, 0.7cqw);
    color: rgb(255 255 255 / 0.8);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.8);
  }

  /* HUD — overlays the bottom 64/520 of the map */
  .hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12.31%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: 1.5625cqw;
    background: var(--ink);
    border-top: 1px solid rgb(113 203 235 / 0.3);
    color: var(--white);
    font-family: var(--font-mono);
  }
  .hud-left, .hud-right {
    display: flex;
    flex-direction: column;
    gap: 0.3cqw;
  }
  .hud-right { align-items: flex-end; text-align: right; }
  .hud-label {
    font-size: 0.703cqw;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--silver-200);
    opacity: 0.8;
  }
  .hud-value {
    font-weight: 700;
    font-size: 1.25cqw;
    line-height: 1;
  }
  .hud-value.base { color: var(--flap-yellow); }

  .track-wrap {
    position: relative;
    width: 40.625cqw;
  }
  .hint {
    position: absolute;
    right: calc(100% + 1.4cqw);
    top: 50%;
    transform: translateY(-50%);
    font-weight: 700;
    font-size: 0.703cqw;
    color: var(--sky-blue);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .track {
    position: relative;
    height: 4cqw;
    display: block;
  }
  .rail, .progress {
    position: absolute;
    left: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
  }
  .rail { right: 0; background: var(--silver-200); opacity: 0.35; }
  .progress { background: var(--sky-blue); }
  .stop {
    position: absolute;
    top: 50%;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: var(--silver-200);
  }
  .stop.reached { background: var(--sky-blue); }
  .stop-code {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.703cqw;
    color: var(--silver-200);
    opacity: 0.7;
  }
  .stop.current .stop-code { color: var(--white); opacity: 1; }
  .thumb {
    position: absolute;
    top: 50%;
    width: 5cqw;
    transform: translate(-50%, -100%);
    pointer-events: none;
  }
  .thumb-plane {
    width: 100%;
    height: auto;
    transform: translateY(calc(var(--lift, 0) * -1px)) rotate(calc(var(--pitch, 0) * -1deg));
    transform-origin: 60% 70%;
  }
  .thumb-shadow {
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 53%;
    height: 4px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.25);
    transform: translateX(-50%) scaleX(calc(1 - var(--lift, 0) / 13 * 0.45));
  }

  /* Interactive slider gets real hit areas and legible sizes */
  .interactive .track {
    cursor: pointer;
    touch-action: pan-y;
  }
  .interactive .stop::after {
    content: '';
    position: absolute;
    inset: -12px -8px;
  }

  @media (min-width: 1024px) {
    .interactive .hud-label, .interactive .hint, .interactive .stop-code { font-size: 9px; }
    .interactive .hud-value { font-size: 16px; }
    .interactive .track-wrap { width: min(520px, 40.625cqw); }
    .interactive .track { height: 52px; }
    .interactive .thumb { width: 64px; }
  }

  /* Below 1024px the HUD moves under the map and the slider goes full width */
  @media (max-width: 1023px) {
    .interactive .credit { bottom: 6px; }
    .interactive .hud {
      position: static;
      height: auto;
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'left right' 'centre centre';
      gap: 14px 12px;
      padding: 14px 16px 18px;
    }
    .interactive .hud-left { grid-area: left; }
    .interactive .hud-right { grid-area: right; }
    .interactive .hud-centre { grid-area: centre; }
    .interactive .hud-label { font-size: 9px; }
    .interactive .hud-value { font-size: 15px; }
    .interactive .track-wrap { width: calc(100% - 56px); margin-inline: 28px; padding-top: 18px; }
    .interactive .credit { font-size: 7px; right: 6px; }
    .interactive .hint {
      right: auto;
      left: -28px;
      top: 0;
      transform: none;
      font-size: 9px;
    }
    .interactive .track { height: 50px; }
    .interactive .stop-code { font-size: 9px; }
    .interactive .thumb { width: 56px; }
  }
</style>
